platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  target 'RunnerUITests' do
    inherit! :complete
  end

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # ── Patch razorpay_flutter 1.4.x for razorpay-pod 1.5.x compatibility ──
  # razorpay_flutter 1.4.x calls subscribeToAnalyticsEvents which was removed
  # in razorpay-pod 1.5.0. Remove the incompatible call and import.
  delegate_path = File.join(
    Dir.glob("#{installer.sandbox.root}/razorpay_flutter/**/*.swift").first || '',
  ).split('/')[0..-1].join('/')

  Dir.glob("#{installer.sandbox.root}/razorpay_flutter/Classes/RazorpayDelegate.swift").each do |file|
    content = File.read(file)
    patched = content
      .gsub("import RazorpayCore\n", "")
      .gsub(", RazorpayEventCallback", "")
      .gsub(/if let events = subscribedAnalyticsEvents.*?razorpay\.subscribeToAnalyticsEvents\(events,\s*callback:\s*self\)\s*\}/m, "")
    File.write(file, patched) if patched != content
    puts "✓ Patched razorpay_flutter/RazorpayDelegate.swift for razorpay-pod 1.5.x" if patched != content
  end
end
