# ─── API ─────────────────────────────────────────────────────
# URL of the Hono API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Analytics ───────────────────────────────────────────────
# Get from: PostHog → Project Settings → API Keys
# Optional during development
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Observability ────────────────────────────────────────────
# Get from: sentry.io → Project Settings → Client Keys → DSN
# Optional during development
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=creatorhub-web
