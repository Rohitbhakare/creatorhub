{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:bdd": "playwright test --project=bdd --grep-invert @known-issue",
    "test:bdd:all": "playwright test --project=bdd",
    "test:bdd:smoke": "playwright test --project=bdd --grep @smoke --grep-invert @known-issue",
    "test:bdd:critical": "playwright test --project=bdd --grep @critical --grep-invert @known-issue",
    "test:bdd:mobile": "playwright test --project=bdd-mobile --grep-invert @known-issue",
    "test:bdd:gen": "bddgen"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "next": "^15.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.0",
    "playwright-bdd": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
